# Server
PORT=4000
NODE_ENV=development

# Auth - change this to a long random string in production
JWT_SECRET=replace-me-with-a-long-random-secret

# Database (SQLite file path, relative to repo root)
DATABASE_FILE=./data/stockflow.sqlite

# Business defaults
DEFAULT_LOW_STOCK_THRESHOLD=5

# Set to true to recreate the demo organization on boot if it is missing.
# Used by the hosted demo, which has an ephemeral database.
SEED_DEMO_DATA=false
